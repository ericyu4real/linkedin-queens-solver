{
  "manifest_version": 3,
  "name": "Queens Auto Solver",
  "version": "1.2.0",
  "description": "Detect a LinkedIn Queens or Queens Ultimate board and fill it when you click Autofill.",
  "action": {
    "default_title": "Queens Auto Solver",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/games/*",
    "https://queensultimate.com/*",
    "https://www.queensultimate.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/games/*",
        "https://queensultimate.com/*",
        "https://www.queensultimate.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["page.js"],
      "type": "module",
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/games/*",
        "https://queensultimate.com/*",
        "https://www.queensultimate.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
